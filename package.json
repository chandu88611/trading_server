{
  "name": "kite-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p .",
    "crm:backfill": "ts-node scripts/backfill-crm-sync.ts",
    "ctrader:requeue": "ts-node scripts/requeue-ctrader-transient-failures.ts",
    "docker:server0:build": "docker compose build server-0",
    "docker:server0:up": "docker compose up -d --build server-0",
    "docker:server0:down": "docker compose down",
    "docker:server0:logs": "docker compose logs -f server-0",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint . --ext .ts",
    "test": "node --test -r ts-node/register/transpile-only src/tests/**/*.test.ts",
    "test:qa": "node --test -r ts-node/register/transpile-only src/tests/**/*.test.ts",
    "test:support": "node --test -r ts-node/register/transpile-only src/tests/support/**/*.test.ts",
    "test:plans": "node --test -r ts-node/register/transpile-only src/tests/subscriptionPlan/**/*.test.ts",
    "test:brokers": "node --test -r ts-node/register/transpile-only src/tests/brokers/**/*.test.ts",
    "start:job-processor": "node dist/src/app/broker/brokerExecution/worker/jobProcessor.js"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/nodemailer": "^7.0.4",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "kiteconnect": "^5.1.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.11",
    "pg": "^8.11.0",
    "razorpay": "^2.9.6",
    "reflect-metadata": "^0.1.13",
    "stripe": "^20.0.0",
    "typeorm": "^0.3.20",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/node": "^20.5.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.6"
  }
}

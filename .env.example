DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kite_db

NODE_ENV=development
JWT_SECRET=change-me-before-production

# Broker credential encryption: AES-256-GCM requires exactly 32 bytes (256 bits).
# Recommended: 64 hex characters, generated with: openssl rand -hex 32
# Also accepts base64 encoding of 32 bytes, or a 32-byte ASCII string (32 characters).
# Set a unique random key before saving credentials; use the same stable key on
# every API/worker instance. Back it up securely; changing it requires re-encryption.
# Legacy plaintext remains readable with a warning; corrupted encrypted data is rejected.
ENCRYPTION_KEY=

# Razorpay payment gateway
RAZORPAY_KEY_ID=rzp_test_Seu9xVnqFqgtgn
RAZORPAY_KEY_SECRET=fLbzA5CEN2sfpqXSO93m1HM0
RAZORPAY_OAUTH_TOKEN=
RAZORPAY_WEBHOOK_SECRET=@vPv4Qi2RvGc865

# RazorpayX payouts
RAZORPAYX_KEY_ID=rzp_test_Seu9xVnqFqgtgn
RAZORPAYX_KEY_SECRET=fLbzA5CEN2sfpqXSO93m1HM0
RAZORPAYX_OAUTH_TOKEN=
RAZORPAYX_WEBHOOK_SECRET=@vPv4Qi2RvGc865
RAZORPAYX_SOURCE_ACCOUNT_NUMBER=JYj7EcQt6tjfNq

# Referral earnings + withdrawals
REFERRAL_LEVEL1_REWARD_INR=
REFERRAL_LEVEL2_REWARD_INR=
REFERRAL_REWARD_HOLD_DAYS=7
DEFAULT_MIN_WITHDRAWAL_INR=500

# Zebu integration
ZEBU_BASE_URL=
ZEBU_SOURCE=WEB
ZEBU_VC_DEFAULT=NOREN_WEB
ZEBU_IMEI=abcd1234
ZEBU_APKVERSION=1.0.0
ZEBU_APPKEY_SEED=S3cur3!d
ZEBU_EXEC_BATCH_SIZE=25
ZEBU_REQUEST_TIMEOUT_MS=15000
# Dedicated verified Zebu account used only for resolver market-data quotes.
ZEBU_MARKET_DATA_TRADING_ACCOUNT_ID=
ZEBU_INSTRUMENT_MASTER_BASE_URL=https://api.shoonya.com
ZEBU_INSTRUMENT_SYNC_TIMEOUT_MS=60000

# CoinDCX integration
COINDCX_BASE_URL=https://api.coindcx.com
# Per-user CoinDCX apiKey/apiSecret should be stored in trading account meta (DB)
# via /coindcx/auth/token; no global env fallback is used for multi-user safety.
COINDCX_ORDER_CREATE_PATH=exchange/v1/orders/create
COINDCX_ORDER_MODIFY_PATH=exchange/v1/orders/edit
COINDCX_ORDER_CANCEL_PATH=exchange/v1/orders/cancel
COINDCX_ACTIVE_ORDERS_PATH=exchange/v1/orders/active_orders
COINDCX_BALANCES_PATH=exchange/v1/users/balances
COINDCX_PUBLIC_BASE_URL=https://api.coindcx.com
COINDCX_PUBLIC_TICKER_PATH=exchange/ticker
COINDCX_PUBLIC_ORDERBOOK_PATH=market_data/orderbook
COINDCX_EXEC_INTERVAL_MS=500
COINDCX_EXEC_BATCH_SIZE=25

# CRM lead conversion sync (triggered on successful login)
CRM_BASE_URL=http://localhost:5000
CRM_CONVERSION_SECRET=my_secret

# SMTP — transactional + trade-notification emails.
# Email features are NO-OP until these are set (the app still boots without them).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TradeBro <no-reply@tradebro.io>"
# Base URL used in verification/links inside emails
APP_BASE_URL=https://app.tradebro.io

# Dev sandbox billing is disabled in production unless explicitly enabled.
ALLOW_SANDBOX_BILLING=false
